APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://ats:ats@db:5432/ats_tracker
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=ats-tracker
STORAGE_ACCESS_KEY=ats-minio
STORAGE_SECRET_KEY=ats-minio-secret
STORAGE_REGION=us-east-1

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

CORS_ORIGINS=http://localhost:3000

DEFAULT_ORG_NAME=ATS Tracker
DEFAULT_ORG_SLUG=ats-tracker
DEFAULT_SUPER_ADMIN_EMAIL=admin@ats-tracker.internal
DEFAULT_SUPER_ADMIN_PASSWORD=change-me-in-production
