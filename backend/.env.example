APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://ats:ats@db:5432/ats_tracker
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production-to-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Object storage for resumes. Leave STORAGE_ENDPOINT_URL EMPTY for real AWS S3 --
# it must be absent, not blank-but-present-as-a-URL. Set it only for an
# S3-compatible service such as MinIO in local development.
# Leave the keys empty on EC2/ECS so boto3 uses the attached IAM role and no
# credentials are stored on disk.
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=ats-tracker
STORAGE_ACCESS_KEY=ats-minio
STORAGE_SECRET_KEY=ats-minio-secret
STORAGE_REGION=us-east-1

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Local deterministic semantic scoring via sentence-transformers. When true, the
# embedding cosine similarity replaces the LLM's numeric match_score.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Weight of skill-tag fit vs. holistic résumé fit in the overall score (0-1).
# Lower rewards strong generalists who miss niche must-have tags.
EVALUATION_SKILL_WEIGHT=0.6

CORS_ORIGINS=http://localhost:3000

# Public URL of the frontend. Links inside outbound email are built from this,
# so in any deployed environment it must be the host recipients can reach.
APP_BASE_URL=http://localhost:3000

# Outbound email. Any SMTP provider works (SES, SendGrid, Mailgun, Postmark,
# Google Workspace). Leave SMTP_HOST empty to disable sending: password resets
# and invitations still issue valid tokens and candidate messages are still
# recorded, they just aren't transmitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587. For implicit TLS on 465, set SMTP_USE_SSL=true instead.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM_EMAIL=no-reply@ats-tracker.local
MAIL_FROM_NAME=ATS Tracker

# Fallback for when SMTP is unconfigured: returns the raw reset token from
# /auth/forgot-password so the flow stays testable. Leaks account existence and
# hands out a working credential-reset token — refused when APP_ENV=production.
EXPOSE_PASSWORD_RESET_TOKEN=false

# Interactive API docs (/docs, /redoc, /openapi.json). Automatically disabled
# when APP_ENV=production because they expose every endpoint and schema to
# unauthenticated callers. Set true only behind a VPN or authenticating proxy.
EXPOSE_API_DOCS=false

DEFAULT_ORG_NAME=Peer Consulting Resources Inc.
DEFAULT_ORG_SLUG=peer-consulting
DEFAULT_SUPER_ADMIN_EMAIL=admin@ats-tracker.internal
DEFAULT_SUPER_ADMIN_PASSWORD=change-me-in-production
